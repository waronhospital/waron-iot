# Port host. Gunakan 8001 bila backend Python lokal masih memakai 8000.
WARON_PORT=8000
# Opsional: token untuk API v1. Dashboard saat ini belum punya login token baca.
NETPULSE_READ_TOKEN=
# Opsional: origin aplikasi lain, dipisahkan koma tanpa spasi.
NETPULSE_CORS_ORIGINS=

# Browser file telemetri (tanpa login), terpisah dari dashboard.
WARON_DATA_PORT=8081
